{
  "$schema": "https://opencode.ai/config.json",

  // Global default model — paid direct endpoint. Full context, no free-tier
  // rate limits/contention. Used as fallback for any agent that doesn't set
  // its own model.
  "model": "google-vertex/gemini-3.1-pro-preview-customtools",
  "default_agent": "architect",
  "update": "notify",

  // Session warming: sends lightweight keep-alives during idle pauses to keep
  // provider-side prompt caches (Vertex/Gemini context caches) hot and reduce latency.
  "warming": {
    "interval": "4 minutes",
    "duration": "30 minutes"
  },

  "plugins": [
    "./plugins/vibeguard"
  ],

  // Project references specific to CSTAF
  "references": {
    "handbook": {
      "path": "/home/cybervitor/Projects/CSTAF/handbook/handbook.wiki",
      "description": "Use for architectural guidelines, Git Trunk Based Development rules, and common pitfalls for CSTAF."
    },
    "teamdocs": {
      "path": "/home/cybervitor/Documents/Work/Software Team Documentation",
      "description": "Logseq knowledge base, ADRs and domain specs for all CSTAF projects."
    }
  },

  // ---------------------------------------------------------------------------
  // 1. PROVIDERS & MODEL ALIASES
  // ---------------------------------------------------------------------------
  "providers": {
    "google-vertex": {
      "models": {
        "flash-current": {
          "modelID": "gemini-3.8-flash",
          "name": "Gemini Flash (Current)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "thinkingConfig": {
                  "includeThoughts": true,
                  "thinkingLevel": "low"
                }
              }
            },
            {
              "id": "medium",
              "settings": {
                "thinkingConfig": {
                  "includeThoughts": true,
                  "thinkingLevel": "medium"
                }
              }
            },
            {
              "id": "high",
              "settings": {
                "thinkingConfig": {
                  "includeThoughts": true,
                  "thinkingLevel": "high"
                }
              }
            }
          ]
        }
      }
    }
  },

  // ---------------------------------------------------------------------------
  // 2. LANGUAGE SERVER PROTOCOL (LSP) CONFIGURATION
  // ---------------------------------------------------------------------------
  "lsp": {
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "php": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".js"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    },
    "odin": {
      "command": ["ols"],
      "extensions": [".odin"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html"]
    },
    "css": {
      "command": ["vscode-css-language-server", "--stdio"],
      "extensions": [".css", ".scss"]
    },
    "makefile": {
      "command": ["makefile-lsp"],
      "extensions": ["Makefile", ".mk"]
    },
    "tailwind": {
      "command": ["tailwindcss-language-server", "--stdio"],
      "extensions": [".css", ".scss", ".html"]
    },
    "markdown": {
      "command": ["marksman", "server"],
      "extensions": [".md", ".markdown", ".mdx"]
    }
  },

  // ---------------------------------------------------------------------------
  // 3. BROWSER & DOCUMENTATION MCP SERVERS
  // ---------------------------------------------------------------------------
  "mcp": {
    "servers": {
      // A. THE API BRIDGE: OpenAPI / REST Server
      "openapi": {
        "type": "local",
        "command": ["uvx", "--with", "mcp<1.6", "mcp-openapi-proxy"],
        "environment": {
          "OPENAPI_SPEC_URL": "http://localhost:8765/swagger.json"
        }
      },

      // B. ANTI-HALLUCINATION: Documentation Scrapers
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "environment": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
      },
      "firecrawl": {
        "type": "local",
        "command": ["npx", "-y", "firecrawl-mcp"],
        "environment": {
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
        }
      },

      // C. CODE SEARCH: Vercel's github grep
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },

      // D. LOCAL GIT: Safe, read-only repository history
      "git": {
        "type": "local",
        "command": [
          "uvx",
          "--with",
          "mcp<2,>=1.7",
          "mcp-server-git"
        ]
      },

      // E. GITLAB: Issue tracking and contract management
      "gitlab": {
        "type": "local",
        "command": ["npx", "-y", "@zereight/mcp-gitlab"],
        "environment": {
          "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_PERSONAL_ACCESS_TOKEN}",
          "GITLAB_API_URL": "https://git.cstaf/api/v4",
          "NODE_TLS_REJECT_UNAUTHORIZED": "0"
        }
      },

      // F. FILESYSTEM: Workspace boundaries (CSTAF, ISEG, Personal, Team Docs, and OpenCode config)
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/home/cybervitor/Projects/CSTAF",
          "/home/cybervitor/Projects/ISEG",
          "/home/cybervitor/Projects/Personal",
          "/home/cybervitor/Documents/Work/Software Team Documentation",
          "/home/cybervitor/.config/opencode"
        ]
      }
    }
  },

  // ---------------------------------------------------------------------------
  // 4. SAFETY GUARDRAILS & PERMISSIONS
  // ---------------------------------------------------------------------------
  // NOTE: Order matters in permissions! The LAST matching rule wins. Broad rules
  // ("*": "allow") must be specified FIRST, followed by specific denials and prompts.
  "permissions": [
    { "action": "git_git_add", "resource": "*", "effect": "deny" },
    { "action": "git_git_commit", "resource": "*", "effect": "deny" },
    { "action": "git_git_reset", "resource": "*", "effect": "deny" },
    { "action": "git_git_checkout", "resource": "*", "effect": "deny" },
    { "action": "git_git_create_branch", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*git push*", "effect": "deny" },
    { "action": "shell", "resource": "*git commit*", "effect": "deny" },
    { "action": "shell", "resource": "*git merge*", "effect": "deny" },
    { "action": "shell", "resource": "*git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "*git cherry-pick*", "effect": "deny" },
    { "action": "shell", "resource": "*mysql*", "effect": "deny" },
    { "action": "shell", "resource": "*psql*", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "*sudo*", "effect": "ask" },
    { "action": "shell", "resource": "*systemctl*", "effect": "ask" },
    { "action": "shell", "resource": "*docker rm*", "effect": "ask" },
    { "action": "shell", "resource": "*docker rmi*", "effect": "ask" },
    { "action": "shell", "resource": "*docker kill*", "effect": "ask" },
    { "action": "shell", "resource": "*docker compose down*", "effect": "ask" },
    { "action": "shell", "resource": "*kubectl delete*", "effect": "ask" },
    { "action": "shell", "resource": "*git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "*git clean*", "effect": "ask" },
    { "action": "shell", "resource": "*cake migrations*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/home/cybervitor/Projects/CSTAF/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/cybervitor/Projects/ISEG/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/cybervitor/Projects/Personal/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/cybervitor/Documents/Work/Software Team Documentation/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/home/cybervitor/.config/opencode/**", "effect": "allow" },
    { "action": "docker_*", "resource": "*", "effect": "ask" }
  ],

  // ---------------------------------------------------------------------------
  // 5. AGENTS & ROLE ROUTING
  // ---------------------------------------------------------------------------
  "agents": {
    "plan": { "disabled": true },
    "lint": { "disabled": true },
    "autocomplete": { "disabled": true },

    // title agent: used internally by OpenCode itself to generate session titles
    // (migrated from V1 small_model). Frequent, tiny, low-stakes calls.
    "title": {
      "model": "google-vertex/gemini-3.5-flash-lite"
    }
  },

  // ---------------------------------------------------------------------------
  // 6. GLOBAL STACK INSTRUCTIONS
  // ---------------------------------------------------------------------------
  "instructions": [
    "~/.config/opencode/instructions.md"
  ]
}
